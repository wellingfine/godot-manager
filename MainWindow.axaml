<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GodotManager.ViewModels"
        xmlns:models="clr-namespace:GodotManager.Models"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="760"
        x:Class="GodotManager.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding L.AppTitle}"
        Width="1080" Height="760" MinWidth="940" MinHeight="620"
        Background="{DynamicResource SurfaceBrush}">
    <Border Background="{DynamicResource SurfaceBrush}">
        <Grid RowDefinitions="Auto,1,*,Auto">
            <!-- 工具栏 -->
            <Grid Grid.Row="0" Margin="16,14,12,12"
                  ColumnDefinitions="Auto,16,260,16,Auto,16,Auto,*,Auto">
                <ListBox Grid.Column="0" Classes="segments" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding MajorGroups}" SelectedItem="{Binding SelectedMajor}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:MajorGroup}">
                            <TextBlock Text="{Binding Label}" FontSize="13" TextAlignment="Center"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Column="2" Classes="searchBox">
                    <Grid ColumnDefinitions="Auto,*">
                        <PathIcon Grid.Column="0" Width="14" Height="14" Margin="11,0,0,0"
                                  Foreground="{DynamicResource MutedTextBrush}"
                                  Data="M10 2a8 8 0 1 0 4.9 14.3l5 5 1.4-1.4-5-5A8 8 0 0 0 10 2zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12z" />
                        <TextBox Grid.Column="1" Classes="search" Margin="8,0,10,0"
                                 VerticalAlignment="Center" Text="{Binding SearchText}"
                                 PlaceholderText="{Binding L.SearchPlaceholder}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Classes="muted" Text="{Binding L.DotNetLabel}" VerticalAlignment="Center" />
                    <ToggleSwitch Classes="switch" IsChecked="{Binding UseMono}" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="6" Classes="filter" ToolTip.Tip="{Binding L.ChannelTooltip}">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Stable" ToggleType="CheckBox" StaysOpenOnClick="True"
                                      IsChecked="{Binding ShowStable, Mode=TwoWay}" />
                            <MenuItem Header="RC" ToggleType="CheckBox" StaysOpenOnClick="True"
                                      IsChecked="{Binding ShowRc, Mode=TwoWay}" />
                            <MenuItem Header="Beta" ToggleType="CheckBox" StaysOpenOnClick="True"
                                      IsChecked="{Binding ShowBeta, Mode=TwoWay}" />
                            <MenuItem Header="Dev" ToggleType="CheckBox" StaysOpenOnClick="True"
                                      IsChecked="{Binding ShowDev, Mode=TwoWay}" />
                            <MenuItem Header="Alpha" ToggleType="CheckBox" StaysOpenOnClick="True"
                                      IsChecked="{Binding ShowAlpha, Mode=TwoWay}" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ChannelSummaryText}" VerticalAlignment="Center" />
                        <PathIcon Width="10" Height="10" Foreground="{DynamicResource MutedTextBrush}"
                                  Data="M7 9.5l5 5 5-5H7z" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="icon" Width="30" Height="30"
                            ToolTip.Tip="{Binding L.SettingsTooltip}" Click="SettingsButton_Click">
                        <PathIcon Width="16" Height="16" Foreground="{DynamicResource MutedTextBrush}"
                                  Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.5.5 0 0 0 .12-.61l-1.92-3.32a.5.5 0 0 0-.6-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.5.5 0 0 0-.5-.42h-3.84a.5.5 0 0 0-.5.42l-.36 2.54c-.59.24-1.13.56-1.62.94l-2.39-.96a.5.5 0 0 0-.6.22L2.72 8.87a.5.5 0 0 0 .12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.5.5 0 0 0-.12.61l1.92 3.32c.12.22.38.3.6.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.25.42.5.42h3.84c.25 0 .45-.18.5-.42l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.48 0 .6-.22l1.92-3.32a.5.5 0 0 0-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 1 1 12 8.4a3.6 3.6 0 0 1 0 7.2z" />
                    </Button>
                    <Button Classes="icon" Command="{Binding ToggleThemeCommand}"
                            ToolTip.Tip="{Binding L.ThemeTooltip}">
                        <Grid>
                            <PathIcon Width="17" Height="17" IsVisible="{Binding !IsDarkTheme}"
                                      Foreground="{DynamicResource MutedTextBrush}"
                                      Data="M12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zM11 1h2v3h-2zM11 20h2v3h-2zM1 11h3v2H1zM20 11h3v2h-3zM3.5 5.9 4.9 4.5 7 6.6 5.6 8zM17 18.1l1.4-1.4 2.1 2.1-1.4 1.4zM18.4 4.5l1.4 1.4-2.1 2.1-1.4-1.4zM4.9 19.5 3.5 18.1 5.6 16l1.4 1.4z" />
                            <PathIcon Width="17" Height="17" IsVisible="{Binding IsDarkTheme}"
                                      Foreground="{DynamicResource MutedTextBrush}"
                                      Data="M20.6 13.6A9 9 0 0 1 10.4 3.4 9 9 0 1 0 20.6 13.6z" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerBrush}" />

            <!-- 内容区 -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                <DockPanel Grid.Column="0" Margin="16,24,12,12">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" Margin="16,0,0,10">
                        <TextBlock Grid.Column="0" Classes="section" Text="{Binding L.AvailableLabel}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" Width="28" Height="28" Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding RefreshReleasesCommand}"
                                ToolTip.Tip="{Binding L.RefreshTooltip}">
                            <PathIcon Width="16" Height="16" Foreground="{DynamicResource MutedTextBrush}"
                                      Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
                        </Button>
                        <TextBlock Grid.Column="3" Classes="muted" Text="{Binding FilteredCountText}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0" ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding SelectedSummaryText}" Classes="muted"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <SplitButton Grid.Column="1" Classes="soft" Content="{Binding L.DownloadExtract}"
                                     Command="{Binding DownloadCommand}"
                                     CommandParameter="{Binding SelectedRelease}"
                                     ToolTip.Tip="{Binding L.PlatformTooltip}">
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="Windows" Command="{Binding DownloadForPlatformCommand}"
                                              CommandParameter="Windows" />
                                    <MenuItem Header="macOS" Command="{Binding DownloadForPlatformCommand}"
                                              CommandParameter="Mac" />
                                    <MenuItem Header="Linux" Command="{Binding DownloadForPlatformCommand}"
                                              CommandParameter="Linux" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                    </Grid>

                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0"
                          ColumnDefinitions="*,12,Auto,8,Auto" IsVisible="{Binding IsDownloading}">
                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress}"
                                     VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" MinWidth="120" Classes="muted" Text="{Binding ProgressText}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="4" Classes="subtle" Content="{Binding L.CancelDownload}"
                                Command="{Binding CancelDownloadCommand}" />
                    </Grid>

                    <ListBox Classes="release" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemsSource="{Binding FilteredReleases}"
                             SelectedItem="{Binding SelectedRelease}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:GodotRelease}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Classes="version" Text="{Binding Id}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Classes="tag" Text="{Binding Channel}" VerticalAlignment="Center" />
                                        <TextBlock Classes="tag" Text="· .NET" VerticalAlignment="Center"
                                                   IsVisible="{Binding ShowDotNetTag}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center" Margin="0,0,18,0">
                                        <Button Classes="rowAction"
                                                ToolTip.Tip="{Binding $parent[Window].DataContext.L.NewsTooltip}"
                                                Command="{Binding $parent[Window].DataContext.OpenNewsCommand}"
                                                CommandParameter="{Binding}">
                                            <PathIcon Width="13" Height="13"
                                                      Foreground="{DynamicResource MutedTextBrush}"
                                                      Data="M14 3h7v7h-2V6.4l-8.3 8.3-1.4-1.4L17.6 5H14V3zM5 5h6v2H7v10h10v-4h2v6H5V5z" />
                                        </Button>
                                        <TextBlock Classes="muted" Text="{Binding DateText}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <Border Grid.Column="1" Width="320" Margin="0,12,12,12" CornerRadius="12"
                        Background="{DynamicResource SidePanelBrush}">
                    <DockPanel Margin="14,12,14,12">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,0,0,10">
                            <TextBlock Classes="section" Text="{Binding L.InstalledLabel}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding InstalledCountText}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" Spacing="10">
                            <Button Classes="primary" Content="{Binding L.Launch}" Height="40"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding LaunchCommand}"
                                    CommandParameter="{Binding SelectedInstalled}" />
                            <Grid ColumnDefinitions="*,10,*">
                                <Button Grid.Column="0" Classes="subtle" Content="{Binding L.OpenFolder}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding SelectedInstalled}" />
                                <Button Grid.Column="2" Classes="subtle" Content="{Binding L.Uninstall}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Command="{Binding UninstallCommand}" />
                            </Grid>
                        </StackPanel>

                        <Grid>
                            <ListBox x:Name="InstalledList" Classes="installed" Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ItemsSource="{Binding Installed}"
                                     SelectedItem="{Binding SelectedInstalled}"
                                     DoubleTapped="InstalledList_DoubleTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:InstalledVersion}">
                                        <StackPanel VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Classes="version" Text="{Binding DisplayName}"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Classes="tag" Text="{Binding DetailText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding L.NoInstalled}" Classes="muted" TextAlignment="Center"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       IsVisible="{Binding HasNoInstalled}" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 状态栏 -->
            <StackPanel Grid.Row="3">
                <Border IsVisible="{Binding HasDownloadFailure}"
                        Background="{DynamicResource SubtleBrush}" Padding="16,8,16,8">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding DownloadFailureReason}"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="muted" FontSize="12" Text="{Binding L.SourcePageLabel}" />
                            <Button Classes="link" MaxWidth="800" HorizontalContentAlignment="Left"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="{Binding DownloadSourcePageUrl}">
                                <TextBlock Text="{Binding DownloadSourcePageUrl}" TextWrapping="Wrap" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="muted" FontSize="12" Text="{Binding L.FileUrlLabel}" />
                            <Button Classes="link" MaxWidth="800" HorizontalContentAlignment="Left"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="{Binding DownloadFileUrl}">
                                <TextBlock Text="{Binding DownloadFileUrl}" TextWrapping="Wrap" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}"
                        Padding="16,8,16,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Status}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3"
                                    VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Classes="muted" FontSize="12" Text="{Binding L.SubtitlePrefix}"
                                       VerticalAlignment="Center" />
                            <Button Classes="link" Content="godotengine.org/download/archive"
                                    Command="{Binding OpenArchiveUrlCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
