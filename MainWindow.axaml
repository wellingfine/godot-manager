<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GodotManager.ViewModels"
        xmlns:models="clr-namespace:GodotManager.Models"
        mc:Ignorable="d" d:DesignWidth="1060" d:DesignHeight="680"
        x:Class="GodotManager.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding L.AppTitle}"
        Width="1060" Height="680" MinWidth="880" MinHeight="540">
    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0" Margin="16,16,16,12" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Classes="muted" Text="{Binding L.SubtitlePrefix}" VerticalAlignment="Center" />
                    <HyperlinkButton Padding="0" FontSize="12" VerticalAlignment="Center"
                                     Content="godotengine.org/download/archive"
                                     Command="{Binding OpenArchiveUrlCommand}"
                                     ToolTip.Tip="https://godotengine.org/download/archive/" />
                    <TextBlock Classes="muted" Text="{Binding L.SubtitleSuffix}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Classes="icon" Width="36" Height="36" Padding="0" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTip.Tip="{Binding L.SettingsTooltip}" Click="SettingsButton_Click">
                    <PathIcon Width="18" Height="18"
                              Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.5.5 0 0 0 .12-.61l-1.92-3.32a.5.5 0 0 0-.6-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.5.5 0 0 0-.5-.42h-3.84a.5.5 0 0 0-.5.42l-.36 2.54c-.59.24-1.13.56-1.62.94l-2.39-.96a.5.5 0 0 0-.6.22L2.72 8.87a.5.5 0 0 0 .12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.5.5 0 0 0-.12.61l1.92 3.32c.12.22.38.3.6.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.25.42.5.42h3.84c.25 0 .45-.18.5-.42l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.48 0 .6-.22l1.92-3.32a.5.5 0 0 0-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 1 1 12 8.4a3.6 3.6 0 0 1 0 7.2z" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,12,360">
                <Border Grid.Column="0" Classes="card">
                    <Grid ColumnDefinitions="Auto,12,*">
                        <Border Grid.Column="0" Classes="panel" Width="76" Padding="2">
                            <ListBox Classes="tabs" Background="Transparent"
                                     ItemsSource="{Binding MajorGroups}" SelectedItem="{Binding SelectedMajor}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:MajorGroup}">
                                        <TextBlock Text="{Binding Label}" TextAlignment="Center" FontWeight="SemiBold" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <DockPanel Grid.Column="2">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Spacing="8">
                                <Grid ColumnDefinitions="Auto,8,*,8,Auto">
                                    <CheckBox Content="{Binding L.DotNetLabel}" VerticalAlignment="Center"
                                              IsChecked="{Binding UseMono}" />
                                    <TextBox Grid.Column="2" Text="{Binding SearchText}"
                                             PlaceholderText="{Binding L.SearchPlaceholder}" />
                                    <Button Grid.Column="4" Classes="icon" Width="34" Height="34" Padding="0"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Command="{Binding RefreshReleasesCommand}"
                                            ToolTip.Tip="{Binding L.RefreshTooltip}">
                                        <PathIcon Width="16" Height="16"
                                                  Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
                                    </Button>
                                </Grid>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding FilteredCountText}" Classes="muted"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <WrapPanel>
                                        <TextBlock Text="{Binding L.ChannelLabel}" VerticalAlignment="Center" Classes="muted"
                                                   Margin="0,0,12,0" ToolTip.Tip="{Binding L.ChannelTooltip}" />
                                        <CheckBox Content="Stable" VerticalAlignment="Center" Margin="0,0,12,0"
                                                  IsChecked="{Binding ShowStable}" />
                                        <CheckBox Content="RC" VerticalAlignment="Center" Margin="0,0,12,0"
                                                  IsChecked="{Binding ShowRc}" />
                                        <CheckBox Content="Beta" VerticalAlignment="Center" Margin="0,0,12,0"
                                                  IsChecked="{Binding ShowBeta}" />
                                        <CheckBox Content="Dev" VerticalAlignment="Center" Margin="0,0,12,0"
                                                  IsChecked="{Binding ShowDev}" />
                                        <CheckBox Content="Alpha" VerticalAlignment="Center"
                                                  IsChecked="{Binding ShowAlpha}" />
                                    </WrapPanel>
                                </DockPanel>
                            </StackPanel>

                            <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0" ColumnDefinitions="*,12,Auto,8,Auto"
                                  IsVisible="{Binding IsDownloading}">
                                <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Progress}" />
                                <TextBlock Grid.Column="2" MinWidth="130" TextAlignment="Right"
                                           VerticalAlignment="Center" Classes="muted" Text="{Binding ProgressText}" />
                                <Button Grid.Column="4" Content="{Binding L.CancelDownload}"
                                        Command="{Binding CancelDownloadCommand}" />
                            </Grid>

                            <Border Classes="panel" Padding="4">
                                <ListBox ItemsSource="{Binding FilteredReleases}" SelectedItem="{Binding SelectedRelease}"
                                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:GodotRelease}">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Border BorderThickness="1" CornerRadius="4" Padding="5,1"
                                                            VerticalAlignment="Center"
                                                            BorderBrush="{DynamicResource BrandBorderBrush}"
                                                            Background="{DynamicResource BrandSurfaceBrush}">
                                                        <TextBlock Text="{Binding Channel}" FontSize="11"
                                                                   Foreground="{DynamicResource BrandBrush}" />
                                                    </Border>
                                                    <Border CornerRadius="4" Padding="5,1" VerticalAlignment="Center"
                                                            Background="{DynamicResource BrandBrush}"
                                                            IsVisible="{Binding ShowDotNetTag}">
                                                        <TextBlock Text=".NET" FontSize="11" Foreground="White" />
                                                    </Border>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="rowAction" Margin="8,0,0,0"
                                                        Content="{Binding $parent[Window].DataContext.L.News}"
                                                        ToolTip.Tip="{Binding $parent[Window].DataContext.L.NewsTooltip}"
                                                        Command="{Binding $parent[Window].DataContext.OpenNewsCommand}"
                                                        CommandParameter="{Binding}" />
                                                <Button Grid.Column="2" Classes="rowAction primary" Margin="8,0,0,0"
                                                        Content="{Binding $parent[Window].DataContext.L.Download}"
                                                        Command="{Binding $parent[Window].DataContext.DownloadCommand}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Grid.Column="3" Margin="8,0,0,0" Text="{Binding DateText}"
                                                           Classes="muted" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </DockPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Classes="card">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="h2" Text="{Binding L.InstalledLabel}" Margin="0,0,0,10" />
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Spacing="8">
                            <Button Classes="primary" Content="{Binding L.Launch}" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding LaunchCommand}" CommandParameter="{Binding SelectedInstalled}" />
                            <Grid ColumnDefinitions="*,8,*">
                                <Button Grid.Column="0" Content="{Binding L.OpenFolder}" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding OpenFolderCommand}" CommandParameter="{Binding SelectedInstalled}" />
                                <Button Grid.Column="2" Content="{Binding L.Uninstall}" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" Command="{Binding UninstallCommand}" />
                            </Grid>
                        </StackPanel>

                        <Border Classes="panel" Padding="4">
                            <Grid>
                                <ListBox x:Name="InstalledList" ItemsSource="{Binding Installed}"
                                         SelectedItem="{Binding SelectedInstalled}" Background="Transparent"
                                         DoubleTapped="InstalledList_DoubleTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:InstalledVersion}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <Border CornerRadius="4" Padding="5,1" VerticalAlignment="Center"
                                                            Background="{DynamicResource BrandBrush}"
                                                            IsVisible="{Binding IsMono}">
                                                        <TextBlock Text=".NET" FontSize="11" Foreground="White" />
                                                    </Border>
                                                    <Border BorderThickness="1" CornerRadius="4" Padding="5,1"
                                                            VerticalAlignment="Center"
                                                            BorderBrush="{DynamicResource BrandBorderBrush}"
                                                            Background="{DynamicResource BrandSurfaceBrush}"
                                                            IsVisible="{Binding !IsMono}">
                                                        <TextBlock Text="{Binding TypeText}" FontSize="11"
                                                                   Foreground="{DynamicResource BrandBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding InstalledAtText}" Classes="muted"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="{Binding L.NoInstalled}" Classes="muted" TextAlignment="Center"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           IsVisible="{Binding HasNoInstalled}" />
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BrandBorderBrush}" Padding="16,8">
            <TextBlock Classes="muted" Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
