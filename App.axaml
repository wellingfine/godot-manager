<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GodotManager.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Godot 蓝主配色：覆盖 Fluent 主题的系统强调色 -->
            <Color x:Key="SystemAccentColor">#FF478CBF</Color>
            <SolidColorBrush x:Key="BrandBrush" Color="#FF3F81BA" />
            <SolidColorBrush x:Key="BrandHoverBrush" Color="#FF346C9E" />
            <SolidColorBrush x:Key="BrandSurfaceBrush" Color="#14478CBF" />
            <SolidColorBrush x:Key="BrandBorderBrush" Color="#40478CBF" />
            <SolidColorBrush x:Key="BrandPanelBrush" Color="#0D478CBF" />
            <SolidColorBrush x:Key="ListItemHoverBrush" Color="#10478CBF" />
            <SolidColorBrush x:Key="ListItemSelectedBrush" Color="#24478CBF" />
            <SolidColorBrush x:Key="ListItemSelectedHoverBrush" Color="#30478CBF" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource BrandSurfaceBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandBorderBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BoxShadow" Value="0 2 10 0 #20000000" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource BrandPanelBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandBorderBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!-- 列表项：hover / 选中与其它控件统一 6px 圆角，间距由 Padding 统一控制 -->
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="ItemRoot" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="ItemContent"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.tabs ListBoxItem">
            <Setter Property="Padding" Value="4,12" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource ListItemHoverBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource ListItemSelectedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource ListItemSelectedHoverBrush}" />
        </Style>

        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource BrandBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrandHoverBrush}" />
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="{DynamicResource BrandHoverBrush}" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="{DynamicResource BrandSurfaceBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandBorderBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!-- 版本列表项操作区：hover 时才可见可点，但始终占位，避免行高/列宽变化引起抖动 -->
        <Style Selector="Button.rowAction">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ListBoxItem:pointerover Button.rowAction">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
    </Application.Styles>
</Application>
